From 4d832e67bc3f2204d897c3bb2dd0a8bd3150ee9d Mon Sep 17 00:00:00 2001
From: Eurus <56497078+Eurus7895@users.noreply.github.com>
Date: Thu, 8 Oct 2026 03:51:59 +0000
Subject: [PATCH 2/2] feat: add a reusable commits workflow and a Renovate
 preset

Every repository carried its own copy of the commit checks, so a fix
had to be repeated in each. Repositories now call one reusable
workflow, pinned by tag, and keep a local verify job so the ruleset
can still require a plain "verify" check.

The Renovate preset enables only the Copier manager, so Renovate opens
a pull request when Template is tagged while Dependabot keeps handling
packages. The identity check accepts [bot] no-reply addresses, which
Renovate commits with.
---
 .github/workflows/commits.yml | 86 +++++++++++++++++++++++++++++++++++
 README.md                     |  6 ++-
 renovate-config.json          | 10 ++++
 3 files changed, 100 insertions(+), 2 deletions(-)
 create mode 100644 .github/workflows/commits.yml
 create mode 100644 renovate-config.json

diff --git a/.github/workflows/commits.yml b/.github/workflows/commits.yml
new file mode 100644
index 0000000..8326155
--- /dev/null
+++ b/.github/workflows/commits.yml
@@ -0,0 +1,86 @@
+name: commits
+
+# Reusable check for every eurus-labs repository: Conventional Commits subjects, no AI or
+# tool attribution, and GitHub no-reply identities. Repositories call it with
+#
+#   jobs:
+#     commits:
+#       uses: eurus-labs/.github/.github/workflows/commits.yml@v1
+#
+# and keep their own `verify` job with `needs: [commits, ...]`: a called workflow's
+# checks are named "<caller job> / <job>", so the gate must live in the caller for the
+# ruleset to keep requiring a plain "verify". It also runs on this repository's own PRs.
+on:
+  workflow_call:
+  pull_request:
+    types: [opened, edited, reopened, synchronize]
+
+permissions:
+  contents: read
+
+jobs:
+  conventional-commits:
+    # Dependabot writes its own titles, which can run past 72 characters. Only it is
+    # exempt: any other bot or app is checked like a person.
+    if: github.event.pull_request.user.login != 'dependabot[bot]'
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Check the title, commit messages and attribution
+        env:
+          # Passed through the environment, never interpolated into the script:
+          # whoever opens the pull request writes these.
+          PR_TITLE: ${{ github.event.pull_request.title }}
+          PR_BODY: ${{ github.event.pull_request.body }}
+          BASE_SHA: ${{ github.event.pull_request.base.sha }}
+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+        run: |
+          pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^[:space:]](.*[^.[:space:]])?$'
+          attribution='^co-authored-by:.*(claude|copilot|codex|chatgpt|anthropic|openai)|^claude-session:|generated[- ](with|by):? .*(claude|copilot|codex)|claude\.ai/code'
+          # The human user's GitHub no-reply address; the repository is public, so a
+          # private email must never land in history.
+          noreply='^[0-9]+\+[A-Za-z0-9-]+(\[bot\])?@users\.noreply\.github\.com$'
+          status=0
+
+          # Here-strings, not pipes: Actions runs this with pipefail, and grep -q exiting
+          # early on a long input would turn a match into a failed pipeline.
+          check_subject() {  # $1 names the source, $2 is the subject
+            if ! grep -Eq "$pattern" <<< "$2"; then
+              echo "::error::$1 is not a Conventional Commits subject (type(scope): imperative subject, no trailing period): $2"
+              status=1
+            elif [ "${#2}" -gt 72 ]; then
+              echo "::error::$1 has ${#2} characters; the limit is 72: $2"
+              status=1
+            fi
+          }
+
+          check_subject "The pull request title" "$PR_TITLE"
+          if grep -Eiq "$attribution" <<< "$PR_TITLE"$'\n'"$PR_BODY"; then
+            echo "::error::The pull request title or description carries AI or tool attribution; remove it."
+            status=1
+          fi
+
+          for sha in $(git rev-list --no-merges "$BASE_SHA..$HEAD_SHA"); do
+            check_subject "Commit ${sha:0:7}" "$(git log -1 --format=%s "$sha")"
+            if grep -Eiq "$attribution" <<< "$(git log -1 --format=%B "$sha")"; then
+              echo "::error::Commit ${sha:0:7} carries AI or tool attribution; reword it without the trailer or footer."
+              status=1
+            fi
+            author_email=$(git log -1 --format=%ae "$sha")
+            committer_email=$(git log -1 --format=%ce "$sha")
+            if ! grep -Eq "$noreply" <<< "$author_email"; then
+              echo "::error::Commit ${sha:0:7} author email is not a GitHub no-reply address (<id>+<login>@users.noreply.github.com)."
+              status=1
+            fi
+            # GitHub itself commits web edits as noreply@github.com; anything else must
+            # be the author.
+            if [ "$committer_email" != "$author_email" ] && [ "$committer_email" != noreply@github.com ]; then
+              echo "::error::Commit ${sha:0:7} committer email differs from the author's; both must be the same user."
+              status=1
+            fi
+          done
+
+          exit "$status"
